[Unit]
Description=Reverse SOCKS5 and MTProto Control Server (Go)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/socks-control
ExecStart=/opt/socks-control/socks-control-linux-amd64 --config /opt/socks-control/config.json
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
